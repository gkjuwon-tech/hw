# Conet Tactile Cloud — backend environment template
#
# Copy this file to `.env` (which is git-ignored) and fill in the blanks:
#
#   cp .env.example .env
#
# Every variable is prefixed CONET_ and maps to a field in
# app/core/config.py. Anything left unset falls back to the default there.

# ── Stripe checkout ──────────────────────────────────────────────────
# Leave ALL THREE blank to run in mock mode (local fake checkout, no
# Stripe calls, no money). Fill in the TEST keys from your Stripe
# Dashboard (Developers → API keys, in "Test mode") to exercise the real
# checkout flow end-to-end with test cards — e.g. 4242 4242 4242 4242,
# any future expiry, any CVC. Swap to live keys (sk_live_… / pk_live_…)
# only for production.
#
# As soon as CONET_STRIPE_SECRET_KEY is non-empty the store switches to
# live mode automatically. CONET_STRIPE_WEBHOOK_SECRET (whsec_…) comes
# from the webhook endpoint you register, or from `stripe listen` when
# testing locally; without it the /v1/store/webhook endpoint cannot
# verify incoming events.
CONET_STRIPE_PUBLISHABLE_KEY=
CONET_STRIPE_SECRET_KEY=
CONET_STRIPE_WEBHOOK_SECRET=

# Force mock mode even when a key is present (handy for offline demos).
# CONET_STRIPE_MOCK_MODE=false

# ── Redirect URLs (Stripe sends the buyer back here) ─────────────────
# Defaults point at the local Vite dev server on :5173. Override for a
# deployed marketing site, e.g. https://conet.studio/product/activate.html
# CONET_STORE_SUCCESS_URL=http://localhost:5173/product/activate.html
# CONET_STORE_CANCEL_URL=http://localhost:5173/product/scanner.html
# Edge Care subscriptions land back on activate.html — there is no
# separate download page anymore. The operator UI is pre-installed on
# the Tactile Edge appliance's integrated touch display.
# CONET_STORE_SOFTWARE_SUCCESS_URL=http://localhost:5173/product/activate.html
# CONET_STORE_SOFTWARE_CANCEL_URL=http://localhost:5173/product/activate.html

# ── Service basics (optional overrides) ──────────────────────────────
# CONET_ENVIRONMENT=dev
# CONET_DATABASE_URL=sqlite+aiosqlite:///./conet_tactile.db
# CONET_AUTH_REQUIRED=false
# CONET_BOOTSTRAP_ADMIN_TOKEN=
